APP_NAME="Gestion de Citas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=citas_app
DB_USERNAME=root
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DRIVER=cookie

# Origen(es) permitido(s) para el frontend (Bootstrap con file:// o servido en otro puerto)
CORS_ALLOWED_ORIGINS=*
